---
import SocialIcon from '@components/generic/SocialIcon.astro';

type SocialIconName = 'github' | 'twitter' | 'linkedin' | 'rss' | 'email';

const socials: Array<{ name: string; url: string; icon: SocialIconName }> = [
  {
    name: 'LinkedIn',
    url: 'https://www.linkedin.com/in/raphael-gottweis-99bab0258/',
    icon: 'linkedin',
  },
  {
    name: 'Email',
    url: 'mailto:raphael.gottweis@wu.ac.at',
    icon: 'email',
  },
];
---

<section class='md:hidden'>
  <h2 class='hidden'>Socials section</h2>
  <ul class='flex gap-4'>
    {
      socials.map((item) => (
        <li class='flex-1 rounded border-2 border-black bg-white text-green-700 card-shadow'>
          <a
            href={item.url}
            target='_blank'
            rel='noopener'
            title={`Go to ${item.name}`}
            class='flex items-center justify-center gap-2 px-4 py-3'
          >
            <SocialIcon icon={item.icon} class='h-5 w-5 shrink-0' />
            <span class='poppins text-black text-sm'>{item.name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
