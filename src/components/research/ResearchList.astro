---
import type { CollectionEntry } from 'astro:content';
import ResearchCard from './ResearchCard.astro';

interface Props {
  projects: CollectionEntry<'research'>[];
}

const { projects } = Astro.props;
---

<ul class='grid md:grid-cols-2 gap-8 items-stretch'>
  {
    projects.map((project) => (
      <li class='flex'>
        <ResearchCard project={project} />
      </li>
    ))
  }
</ul>
