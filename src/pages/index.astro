---
import MobileSocials from '@components/home/MobileSocials.astro';
import { Button, Card, Pill } from '@eliancodes/brutal-ui';
import Layout from '@layouts/Default.astro';
import profile from '../assets/profile.jpg';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const collaborators = [
  { name: 'karriere.at', note: "Austria's largest job platform — job posting data for the AI-exposure project" },
  { name: 'Notruf Niederösterreich GmbH', note: 'emergency call and dispatch data for the gender-in-EMS paper' },
  { name: 'Linz Netz GmbH & Netz Oberösterreich GmbH', note: "Upper Austria's two largest grid operators — field experiment on electricity consumption" },
  { name: 'World Bank (EuroCOMP Lab)', note: 'consulting on impact evaluations of EU cohesion-policy programs' },
];

const featuredSlugs = ['ai-labor-market-austria', 'working-from-home', 'gender-ems'];
const featuredThumbs: Record<string, string> = {
  'ai-labor-market-austria': '/research/ai-labor-market.svg',
  'working-from-home': '/research/working-from-home.svg',
  'gender-ems': '/research/gender-ems.svg',
};
const allProjects = await getCollection('research');
const featuredProjects = featuredSlugs
  .map((slug) => allProjects.find((p) => p.id === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
---

<Layout
  title='Home'
  pageTitle='Raphael Gottweis | Home'
  description='Raphael Gottweis is a PhD student in Economics at WU Vienna, working on labor economics, working from home, AI, and behavioral economics.'
  navClass='bg-slate-100'
>
  <main class='bg-blue-theme p-6'>
    <MobileSocials />
    <section id='about' class='grid md:grid-cols-8 gap-8 mt-4 items-start'>
      <h2 class='hidden'>About Raphael Gottweis</h2>
      <div class='col-span-8 md:col-span-5'>
        <Card color='#86efac'>
          <div class='flex flex-col justify-between items-start gap-4'>
            <p class='mt-4 outfit text-2xl md:text-5xl lg:text-6xl'>
              Hi, I'm Raphael
            </p>
            <p class='outfit text-xl md:text-2xl lg:text-3xl'>
              I'm a PhD student in Economics at <a
                class='underline'
                target='_blank'
                rel='noopener'
                href='https://www.wu.ac.at/'>WU Vienna</a
              >, working on labor economics — homeoffice and AI in particular.
            </p>
            <p class='poppins text-lg'>
              I also teach Public Economics and Labour Economics at WU, and
              I'm a Research Associate at the <a
                class='underline'
                target='_blank'
                rel='noopener'
                href='https://energieinstitut-linz.at/team/raphael-gottweis-msc/'>Energy Institute at JKU Linz</a
              >.
            </p>
            <p class='poppins text-lg'>
              Reach me at <a
                class='underline'
                href='mailto:raphael.gottweis@wu.ac.at'>raphael.gottweis@wu.ac.at</a
              > or on <a
                class='underline'
                target='_blank'
                rel='noopener'
                href='https://www.linkedin.com/in/raphael-gottweis-99bab0258/'>LinkedIn</a
              >.
            </p>
            <div class='flex gap-4 flex-wrap'>
              <Button target={'_self'} href='/research/'>
                See my research &rarr;
              </Button>
              <Button target={'_self'} href='/cv/'>
                My CV &rarr;
              </Button>
            </div>
          </div>
        </Card>
      </div>
      <div class='col-span-8 md:col-span-3'>
        <Card color='white'>
          <div class='h-64 md:h-[380px] w-full rounded-lg border-[3px] border-black overflow-hidden'>
            <Image
              src={profile}
              alt='Raphael Gottweis'
              width={600}
              height={700}
              class='h-full w-full object-cover'
            />
          </div>
        </Card>
      </div>
    </section>

    <section class='mt-8'>
      <Card color='#f9a8d4'>
        <h2 class='text-2xl md:text-4xl lg:text-5xl mb-6 dm-serif'>
          What I'm currently obsessed with
        </h2>
        <ul class='poppins space-y-3 list-disc list-inside'>
          <li>
            Thinking about how homeoffice doesn't just reshape my own
            workday, but that of hundreds of thousands of Austrians
          </li>
          <li>
            Falling a little for LLMs, and trying to figure out how to
            personalize the useful parts without slipping into the <a
              class='underline'
              target='_blank'
              rel='noopener'
              href='https://www.nytimes.com/2026/08/14/magazine/ai-chatbots-internet-communication-loops.html'
            >bot loop</a>
          </li>
        </ul>
      </Card>
    </section>

    <section class='mt-8'>
      <Card color='#d8b4fe'>
        <div class='flex justify-between items-end flex-wrap gap-4 mb-6'>
          <h2 class='text-2xl md:text-4xl lg:text-5xl dm-serif'>
            Recent projects
          </h2>
          <Button target={'_self'} href='/research/'>
            View all papers &rarr;
          </Button>
        </div>
        <div class='grid md:grid-cols-3 gap-8'>
          {
            featuredProjects.map((project) => (
              <a href={`/research/#${project.id}`} class='block'>
                <Card color='white'>
                  <div class='h-40 rounded-lg border-[3px] border-black overflow-hidden'>
                    <img
                      src={featuredThumbs[project.id]}
                      alt=''
                      class='h-full w-full object-cover'
                    />
                  </div>
                  <h3 class='poppins text-lg md:text-xl mt-4'>
                    {project.data.title}
                  </h3>
                  <p class='poppins mt-2 text-sm'>
                    {project.data.description}
                  </p>
                </Card>
              </a>
            ))
          }
        </div>
      </Card>
    </section>

    <section class='mt-8 grid md:grid-cols-2 gap-8 items-stretch'>
      <Card color='white'>
        <h2 class='text-2xl md:text-4xl mb-4 dm-serif'>Background</h2>
        <p class='poppins'>
          I studied economics at WU Vienna (BSc, MSc Science Track, top 1% of
          my cohort), with an exchange semester at ISCTE Business School in
          Lisbon. During my PhD, I've consulted for the World Bank's EuroCOMP
          Lab, designing impact evaluations for EU cohesion-policy programs.
          Before that, during my Master's, I was a student assistant on
          behavioral economics and public finance projects at the Institute
          for Advanced Studies (IHS).
        </p>
      </Card>
      <Card color='white'>
        <h2 class='text-2xl md:text-4xl mb-4 dm-serif'>
          Working with companies and policy
        </h2>
        <p class='poppins mb-4'>
          I like research that is useful outside of academia. Some of the
          organizations I collaborate with:
        </p>
        <ul class='flex flex-wrap gap-3'>
          {
            collaborators.map((c) => (
              <li title={c.note}>
                <Pill>{c.name}</Pill>
              </li>
            ))
          }
        </ul>
      </Card>
    </section>
  </main>
</Layout>
